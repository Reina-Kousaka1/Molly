# Copy these names into /etc/molly/molly.env. Leave values out of Git.
MOLLY_DISCORD_TOKEN=

# Optional privileged intent for welcome/goodbye joins and member-count tracking.
# Also enable GUILD_MEMBERS in the Discord Developer Portal before setting true.
MOLLY_GUILD_MEMBERS_INTENT=false

# Explicit Molly owner/developer Discord IDs, comma-separated. Guild roles do not grant access.
MOLLY_DEVELOPER_IDS=
MOLLY_VERSION=1.2
MOLLY_COMMIT=

# Optional constrained local updater. Configure both or neither.
# The endpoint is intentionally restricted to loopback HTTP; never expose it publicly.
MOLLY_UPDATER_URL=
MOLLY_UPDATER_TOKEN=

# Lavalink runs locally as a Molly-only service.
MOLLY_LAVALINK_URL=http://127.0.0.1:2333
MOLLY_LAVALINK_PASSWORD=
MOLLY_LAVALINK_TIMEOUT_MS=5000

# Local SeaWorld socket. The installed systemd template also supplies this path.
MOLLY_SEAWORLD_SOCKET=
# Persistence stays on SeaWorld unless an operator explicitly selects PreppyDB.
MOLLY_PERSISTENCE_BACKEND=seaworld
# PreppyDB uses private plain HTTP only; provision both collections before startup.
# PreppyDB has a 4 MiB document limit; Molly rejects state above its 3 MiB adapter bound.
MOLLY_PREPPYDB_URL=
MOLLY_PREPPYDB_TOKEN=
MOLLY_PREPPYDB_TIMEOUT_MS=3000
MOLLY_PREPPYDB_MAX_RESPONSE_BYTES=4194304
# Personality Engine V1 (integration phase). Disabled by default; when enabled
# it responds only to direct Molly mentions; no commands or actions are delegated.
# Keep Ollama on loopback or a trusted private network; never expose port 11434 publicly.
# Misconfiguration keeps the engine off and never stops Molly.
MOLLY_PERSONALITY_ENGINE_ENABLED=false
MOLLY_OLLAMA_URL=http://127.0.0.1:11434
MOLLY_OLLAMA_MODEL=
MOLLY_OLLAMA_TIMEOUT_MS=15000
MOLLY_OLLAMA_MAX_RESPONSE_BYTES=262144
# Legacy Phase-0 settings; the HTTP endpoint is not used by Molly startup.
SEAWORLD_HEALTH_URL=
SEAWORLD_TIMEOUT_MS=1000
SEAWORLD_RETRY_ATTEMPTS=1
